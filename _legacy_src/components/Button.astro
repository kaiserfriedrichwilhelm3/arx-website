---
/*
 * Button.astro — three variants: primary, secondary, link.
 *
 * Polymorphic: renders <a> when href is set, otherwise <button>.
 * Per the accent contrast rule, accent colors are decorative only —
 * primary buttons use ink-on-bg (inverted), secondary use bg-on-ink
 * on hover, link variant uses --accent only as the underline color.
 *
 * Hover patterns (flagged for Pass 1 visual pass):
 *   - primary: filter: brightness(1.15) — if muddy on real displays,
 *     swap to a new --ink-hover token instead of fixing per-component.
 *   - secondary: full inversion (transparent → solid ink). The loudest
 *     interaction in the system. If it feels out of register in Pass 1,
 *     swap to a quieter pattern (border-color shift / opacity / rgba).
 */
interface Props {
  variant?: "primary" | "secondary" | "link";
  href?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  ariaLabel?: string;
}
const {
  variant = "primary",
  href,
  type = "button",
  disabled = false,
  ariaLabel,
} = Astro.props;
const Tag = href ? "a" : "button";
---
<Tag
  class:list={["btn", `btn-${variant}`]}
  href={href}
  type={!href ? type : undefined}
  disabled={!href ? disabled : undefined}
  aria-disabled={href && disabled ? "true" : undefined}
  aria-label={ariaLabel}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-small);
    line-height: var(--leading-base);
    font-weight: 500;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition:
      background-color var(--motion-fast) var(--ease-out),
      color            var(--motion-fast) var(--ease-out),
      border-color     var(--motion-fast) var(--ease-out),
      filter           var(--motion-fast) var(--ease-out);
  }
  .btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .btn[disabled], .btn[aria-disabled="true"] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-primary {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .btn-primary:hover:not([disabled]):not([aria-disabled="true"]) {
    filter: brightness(1.15);
  }

  .btn-secondary {
    background: transparent;
    color: var(--ink);
    border-color: var(--ink);
  }
  .btn-secondary:hover:not([disabled]):not([aria-disabled="true"]) {
    background: var(--ink);
    color: var(--bg);
  }

  .btn-link {
    min-height: auto;
    padding: 0;
    background: transparent;
    color: var(--ink);
    border: 0;
    border-radius: 0;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .btn-link:hover { text-decoration-color: var(--accent-deep); }
</style>
