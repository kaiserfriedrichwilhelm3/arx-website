---
/*
 * GalenHero.astro — Galen page hero.
 *
 * 100svh on desktop, content centered. No accent-color word treatment
 * on this page — the homepage owns the "answered." moment; Galen's
 * headline is type weight, not color. Single primary CTA (no
 * secondary).
 *
 * Entrance choreography (one-time on load):
 *   kicker     0ms   600ms ease-out translateY 20→0
 *   headline   100ms 600ms
 *   subhead    200ms 600ms
 *   CTA        300ms 600ms
 *
 * opacity:1 throughout; only transform animates. Headline paints
 * immediately. Reduced-motion disables every entrance.
 */
import Kicker from "./Kicker.astro";
import Button from "./Button.astro";
---
<section class="ghero" aria-labelledby="ghero-heading">
  <div class="ghero-inner">
    <div class="ghero-stack">
      <div class="ghero-kicker">
        <Kicker>Galen · AI receptionist for medical practices</Kicker>
      </div>
      <h1 id="ghero-heading" class="ghero-headline">
        Every call answered. Every appointment booked.
      </h1>
      <p class="ghero-subhead">
        Galen runs on AIMS — the modular architecture behind every ARX
        receptionist. Activate the capabilities your practice needs:
        reception, scheduling, intake, insurance, triage, follow-up.
        Each module is a focused agent built on the shared AIMS core.
      </p>
      <div class="ghero-cta">
        <Button variant="primary" href="/contact">Get Started</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .ghero {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: var(--space-7);
  }
  .ghero-inner {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
  .ghero-stack {
    max-width: var(--container-prose);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
  }
  .ghero-headline {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    color: var(--ink);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin: 0;
    margin-top: var(--space-3);
  }
  .ghero-subhead {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--leading-base);
    color: var(--muted);
    max-width: 560px;
    margin: 0;
    margin-top: var(--space-3);
  }
  .ghero-cta {
    margin-top: var(--space-4);
  }

  .ghero-kicker, .ghero-headline, .ghero-subhead, .ghero-cta {
    animation: ghero-rise 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .ghero-kicker   { animation-delay:   0ms; }
  .ghero-headline { animation-delay: 100ms; }
  .ghero-subhead  { animation-delay: 200ms; }
  .ghero-cta      { animation-delay: 300ms; }

  @keyframes ghero-rise {
    from { opacity: 1; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ghero-kicker, .ghero-headline, .ghero-subhead, .ghero-cta {
      animation: none;
    }
  }
</style>
