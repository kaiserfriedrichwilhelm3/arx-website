---
/*
 * ClosingCTA.astro — final section before the footer.
 *
 * Re-asks for the conversation. Centered, --container-prose width,
 * single primary button → /contact.
 *
 * Vertical padding: --space-7 above, --space-8 below (per the brief).
 * Built standalone rather than via Section primitive because the
 * layout is centered, not left-aligned like Section's default.
 */
import Button from "./Button.astro";
---
<section class="closing">
  <div class="closing-inner">
    <h2 class="closing-heading">See what AIMS could do for your practice.</h2>
    <p class="closing-body">
      We pilot with a small number of practices each quarter. Tell us
      about your front-desk volume and we'll be in touch within 48 hours.
    </p>
    <div class="closing-cta">
      <Button variant="primary" href="/contact">Get Started</Button>
    </div>
  </div>
</section>

<style>
  .closing {
    padding-block: var(--space-7) var(--space-8);
    scroll-margin-top: var(--space-5);
  }
  .closing-inner {
    max-width: var(--container-prose);
    margin-inline: auto;
    padding-inline: var(--space-4);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }
  .closing-heading {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: var(--leading-snug);
    color: var(--ink);
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .closing-body {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--leading-base);
    color: var(--muted);
    margin: 0;
    max-width: 480px;
  }
  .closing-cta {
    margin-top: var(--space-3);
  }
</style>
