---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const pillars = await getCollection('pillars');
  return pillars.map(p => ({ params: { slug: p.slug }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const all = (await getCollection('pillars')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex(p => p.slug === entry.slug);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;
---
<BaseLayout title={`Pillar ${entry.data.number} · ${entry.data.title}`} description={entry.data.summary}>
  <article class="pillar-page">
    <header class="wrap pillar-head">
      <p class="eyebrow reveal">Pillar {entry.data.number} · The Cespedes Method</p>
      <h1 class="serif reveal" style={`view-transition-name: pillar-${entry.slug}`}>{entry.data.title}</h1>
      <p class="lede reveal serif-italic">{entry.data.subtitle}</p>
      <div class={`status ${entry.data.status === 'live' ? 'status-live' : ''} reveal`}>
        <span class="status-dot"></span>{entry.data.statusLabel}
      </div>
    </header>

    <hr class="rule" />

    <div class="wrap-prose body reveal">
      <Content />
    </div>

    {entry.slug === 'voice' && (
      <section class="audio-sample" aria-labelledby="audio-h">
        <div class="wrap-prose">
          <hr class="rule" style="margin-bottom: 56px;" />
          <p class="eyebrow">Sample call</p>
          <h2 class="serif" id="audio-h" style="margin-top: 16px;">Listen.</h2>
          <p class="lede" style="margin-top: 16px;">
            A representative interaction from the reference deployment. Names and identifying details are synthetic;
            the cadence, escalation pattern, and bilingual handoff are not.
          </p>
          <figure class="player">
            <audio id="voice-sample" controls preload="none" src="/audio/voice-sample-placeholder.mp3">
              Your browser does not support the audio element.
            </audio>
            <figcaption class="mono caption">
              Placeholder file. Real samples replace this once consent and de-identification are complete.
            </figcaption>
          </figure>
        </div>
      </section>
    )}

    <hr class="rule" />

    <nav class="wrap pager" aria-label="Pillar navigation">
      <div class="pager-side">
        {prev && (
          <a href={`/method/${prev.slug}`} class="pager-link">
            <span class="mono dir">← Previous pillar</span>
            <span class="serif name">{prev.data.title}</span>
          </a>
        )}
      </div>
      <a href="/method" class="pager-up mono">All pillars</a>
      <div class="pager-side right">
        {next && (
          <a href={`/method/${next.slug}`} class="pager-link right">
            <span class="mono dir">Next pillar →</span>
            <span class="serif name">{next.data.title}</span>
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>
<style>
  .pillar-head { padding-top: clamp(72px, 10vw, 112px); padding-bottom: clamp(48px, 7vw, 72px); }
  .pillar-head > * + * { margin-top: 24px; }
  .pillar-head h1 { font-size: var(--t-display); letter-spacing: var(--track-tight); }
  .serif-italic { font-family: var(--font-serif); font-style: italic; color: var(--ink); max-width: 38ch; }

  .body { padding-block: clamp(48px, 7vw, 80px); }
  .body :global(h2) {
    font-family: var(--font-serif); font-size: var(--t-h2);
    margin-top: 56px; margin-bottom: 16px; letter-spacing: var(--track-tight);
  }
  .body :global(h2:first-child) { margin-top: 0; }
  .body :global(p) { margin-top: 18px; font-size: var(--t-lede); line-height: var(--lh-loose); color: var(--ink-2); }
  .body :global(p + p) { margin-top: 18px; }
  .body :global(strong) { color: var(--ink); font-weight: 500; }

  .pager { display: grid; grid-template-columns: 1fr auto 1fr; gap: 32px; align-items: center; padding-block: 56px; }
  .pager-side.right { text-align: right; }
  .pager-link { display: inline-flex; flex-direction: column; gap: 6px; }
  .pager-link.right { align-items: flex-end; }
  .pager-link .dir { font-size: var(--t-micro); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--muted); }
  .pager-link .name { font-size: var(--t-h3); color: var(--ink); }
  .pager-link:hover .name { color: var(--forest); }
  .pager-up { font-size: var(--t-micro); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--ink-2); border: 1px solid var(--rule-strong); padding: 10px 14px; border-radius: 2px; }
  .pager-up:hover { border-color: var(--ink); }
  @media (max-width: 720px) {
    .pager { grid-template-columns: 1fr; text-align: left; }
    .pager-side, .pager-side.right { text-align: left; }
    .pager-link.right { align-items: flex-start; }
  }

  .audio-sample { padding-block: clamp(40px, 6vw, 64px); }
  .player { margin-top: 32px; }
  .player audio { width: 100%; height: 44px; }
  .caption { display: block; font-size: var(--t-micro); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--muted); margin-top: 12px; }
</style>
