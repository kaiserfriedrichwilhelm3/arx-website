<script is:inline>
(function(){
'use strict';

var REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var FINE    = window.matchMedia('(pointer: fine)').matches;
var doc     = document.documentElement;

/* ═══════════════════════════════════════════════════════════════════════
   MOTION CORE — one rAF loop drives lerped scroll, parallax, progress, nav
   ═══════════════════════════════════════════════════════════════════════ */
var scrollY   = window.scrollY || 0;
var targetY   = scrollY;
var rafId     = null;
var parallax  = [];
var maxScroll = 0;

var progressEl = document.getElementById('progress');
var navEl      = document.getElementById('nav');

function limit(){
  return Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
}

function measure(){
  maxScroll = limit();
  parallax = [];
  var nodes = document.querySelectorAll('[data-par]');
  // Clear first: a rect read while our own translate is applied would fold
  // the current offset into `mid` and compound on every re-measure.
  for (var c = 0; c < nodes.length; c++) nodes[c].style.transform = '';
  for (var i = 0; i < nodes.length; i++){
    var el = nodes[i];
    var r  = el.getBoundingClientRect();
    parallax.push({
      el: el,
      speed: parseFloat(el.getAttribute('data-par')) || 0,
      mid: r.top + window.scrollY + r.height / 2
    });
  }
  paint();
}

function paint(){
  var vh = window.innerHeight;
  if (!REDUCED){
    for (var i = 0; i < parallax.length; i++){
      var p = parallax[i];
      var d = (scrollY + vh / 2) - p.mid;
      if (Math.abs(d) > vh * 2.2) continue;   // skip far-offscreen work
      p.el.style.transform = 'translate3d(0,' + (d * p.speed).toFixed(2) + 'px,0)';
    }
  }
  if (progressEl) progressEl.style.transform = 'scaleX(' + (maxScroll ? scrollY / maxScroll : 0) + ')';
  if (navEl) navEl.classList.toggle('stuck', scrollY > 24);
}

/* --- Lerped ("smooth") scroll. Desktop + fine pointer + motion allowed. --- */
var LERP_ON = !REDUCED && FINE && !window.matchMedia('(hover: none)').matches;

function tick(){
  var delta = targetY - scrollY;
  if (Math.abs(delta) < 0.35){
    scrollY = targetY;
    window.scrollTo(0, scrollY);
    rafId = null;
    paint();
    return;
  }
  scrollY += delta * 0.105;
  window.scrollTo(0, scrollY);
  paint();
  rafId = requestAnimationFrame(tick);
}

function drive(){ if (rafId === null) rafId = requestAnimationFrame(tick); }

function glideTo(y){
  targetY = Math.max(0, Math.min(y, limit()));
  if (LERP_ON) drive();
  else window.scrollTo({ top: targetY, behavior: REDUCED ? 'auto' : 'smooth' });
}

if (LERP_ON){
  doc.classList.add('lerp');
  window.addEventListener('wheel', function(e){
    if (e.ctrlKey) return;                       // let pinch-zoom through
    if (document.body.classList.contains('menu-open')){ e.preventDefault(); return; }
    e.preventDefault();
    var d = e.deltaY * (e.deltaMode === 1 ? 22 : e.deltaMode === 2 ? window.innerHeight : 1);
    targetY = Math.max(0, Math.min(targetY + d, limit()));
    drive();
  }, { passive: false });
}

// Our own writes read back within a pixel of `scrollY`. Anything further away
// is an external scroll — a scrollbar drag, keyboard paging, find-in-page — so
// adopt it AND cancel the pending frame. Without the cancel, a glide that has
// converged but not yet run its final tick will write its old target back and
// yank the user out of wherever they just went.
window.addEventListener('scroll', function(){
  var y = window.scrollY;
  if (Math.abs(y - scrollY) > 2){
    scrollY = targetY = y;
    if (rafId !== null){ cancelAnimationFrame(rafId); rafId = null; }
  }
  paint();
}, { passive: true });

window.addEventListener('resize', measure, { passive: true });

/* --- Anchor links route through the same easing --- */
document.addEventListener('click', function(e){
  var a = e.target.closest ? e.target.closest('a[href^="#"]') : null;
  if (!a) return;
  var id = a.getAttribute('href');
  if (!id || id === '#') return;
  var el = document.querySelector(id);
  if (!el) return;
  e.preventDefault();
  closeMenu();
  var top = el.getBoundingClientRect().top + window.scrollY;
  var pad = (id === '#top') ? 0 : (navEl ? navEl.offsetHeight + 18 : 80);
  glideTo(top - pad);
  history.replaceState(null, '', id === '#top' ? location.pathname : id);
});

/* ═══════════════════════════════════════════════════════════════════════
   TEXT — word-level mask reveal
   ═══════════════════════════════════════════════════════════════════════ */
function splitWords(el){
  var frag = document.createDocumentFragment();
  var n = 0;

  (function walk(node, accent){
    var kids = Array.prototype.slice.call(node.childNodes);
    for (var i = 0; i < kids.length; i++){
      var child = kids[i];

      if (child.nodeType === 3){
        var parts = child.textContent.split(/(\s+)/);
        for (var j = 0; j < parts.length; j++){
          var p = parts[j];
          if (!p) continue;
          if (/^\s+$/.test(p)){ frag.appendChild(document.createTextNode(' ')); continue; }
          var outer = document.createElement('span');
          outer.className = 'w';
          var inner = document.createElement(accent ? 'em' : 'span');
          inner.className = 'wi';
          inner.textContent = p;
          inner.style.setProperty('--d', Math.min(n * 42, 900) + 'ms');
          outer.appendChild(inner);
          frag.appendChild(outer);
          n++;
        }
        continue;
      }

      if (child.nodeType === 1){
        if (child.tagName === 'BR'){ frag.appendChild(document.createElement('br')); continue; }
        // .hl wrappers force a hard line break in the display type
        if (child.classList && child.classList.contains('hl')){
          var line = document.createElement('span');
          line.className = 'hl';
          var hold = frag;
          frag = document.createDocumentFragment();
          walk(child, accent);
          line.appendChild(frag);
          frag = hold;
          frag.appendChild(line);
          continue;
        }
        walk(child, accent || child.tagName === 'EM' || (child.classList && child.classList.contains('ac')));
      }
    }
  })(el, false);

  el.textContent = '';
  el.appendChild(frag);
}

var splits = document.querySelectorAll('.split');
for (var s = 0; s < splits.length; s++) splitWords(splits[s]);

/* ═══════════════════════════════════════════════════════════════════════
   REVEAL — IntersectionObserver
   ═══════════════════════════════════════════════════════════════════════ */
var revealTargets = document.querySelectorAll('.sec, .hero, .split, .rv, .hair, .faq-wrap, .caps, .acq-grid');
if ('IntersectionObserver' in window && !REDUCED){
  var io = new IntersectionObserver(function(entries){
    for (var i = 0; i < entries.length; i++){
      if (!entries[i].isIntersecting) continue;
      var el = entries[i].target;
      var d = el.getAttribute && el.getAttribute('data-d');
      if (d) el.style.setProperty('--d', d + 'ms');
      el.classList.add('is-in');
      io.unobserve(el);
    }
  }, { threshold: 0.06, rootMargin: '0px 0px -8% 0px' });
  for (var r = 0; r < revealTargets.length; r++) io.observe(revealTargets[r]);
} else {
  for (var r2 = 0; r2 < revealTargets.length; r2++) revealTargets[r2].classList.add('is-in');
}

/* ═══════════════════════════════════════════════════════════════════════
   MAGNETIC BUTTONS
   ═══════════════════════════════════════════════════════════════════════ */
if (FINE && !REDUCED){
  var magnets = document.querySelectorAll('[data-magnet]');
  for (var m = 0; m < magnets.length; m++) bindMagnet(magnets[m]);
}
function bindMagnet(zone){
  var el = zone.firstElementChild;
  if (!el) return;
  var label = el.querySelector('.l');
  var k = parseFloat(zone.getAttribute('data-magnet')) || 0.3;
  var tx = 0, ty = 0, cx = 0, cy = 0, loop = null;

  function frame(){
    cx += (tx - cx) * 0.16;
    cy += (ty - cy) * 0.16;
    el.style.transform = 'translate3d(' + cx.toFixed(2) + 'px,' + cy.toFixed(2) + 'px,0)';
    if (label) label.style.transform = 'translate3d(' + (cx * 0.32).toFixed(2) + 'px,' + (cy * 0.32).toFixed(2) + 'px,0)';
    if (Math.abs(tx - cx) > 0.12 || Math.abs(ty - cy) > 0.12){ loop = requestAnimationFrame(frame); }
    else { loop = null; }
  }
  function kick(){ if (loop === null) loop = requestAnimationFrame(frame); }

  zone.addEventListener('pointermove', function(e){
    if (e.pointerType !== 'mouse') return;
    var r = el.getBoundingClientRect();
    tx = (e.clientX - (r.left + r.width / 2)) * k;
    ty = (e.clientY - (r.top + r.height / 2)) * k * 0.8;
    kick();
  });
  zone.addEventListener('pointerleave', function(){ tx = 0; ty = 0; kick(); });
}

/* ═══════════════════════════════════════════════════════════════════════
   ECG SIGNATURE
   ═══════════════════════════════════════════════════════════════════════ */
(function(){
  var trace = document.getElementById('ecgTrace');
  var dim   = document.getElementById('ecgDim');
  var scan  = document.getElementById('ecgScan');
  var hero  = document.querySelector('.hero');
  if (!trace) return;

  var W = 1600, mid = 78, d = 'M0 ' + mid;
  for (var cx = 130; cx < W; cx += 250){
    d += ' L' + (cx - 44) + ' ' + mid +
         ' L' + (cx - 30) + ' ' + (mid - 7) +
         ' L' + (cx - 18) + ' ' + (mid + 9) +
         ' L' + (cx - 9)  + ' ' + mid +
         ' L' + cx        + ' ' + (mid - 62) +
         ' L' + (cx + 9)  + ' ' + (mid + 30) +
         ' L' + (cx + 18) + ' ' + mid +
         ' L' + (cx + 34) + ' ' + (mid - 13) +
         ' L' + (cx + 56) + ' ' + mid;
  }
  d += ' L' + W + ' ' + mid;

  trace.setAttribute('d', d);
  if (dim)  dim.setAttribute('d', d);
  if (scan) scan.setAttribute('d', d);

  var len = 0;
  try { len = Math.ceil(trace.getTotalLength()); } catch (e) { len = 4000; }
  if (!len) len = 4000;
  trace.style.setProperty('--len', len);
  if (scan) scan.style.setProperty('--len', len);

  if (hero){
    if (REDUCED) hero.classList.add('ecg-done');
    else setTimeout(function(){ hero.classList.add('ecg-done'); }, 3900);
  }
})();

/* ═══════════════════════════════════════════════════════════════════════
   THE GALEN INTERFACE — scroll-triggered call simulation
   ═══════════════════════════════════════════════════════════════════════ */
(function(){
  var term   = document.getElementById('term');
  var log    = document.getElementById('termLog');
  var wave   = document.getElementById('wave');
  var rail   = document.getElementById('railList');
  var commit = document.getElementById('railCommit');
  var status = document.getElementById('termStatus');
  var clock  = document.getElementById('termClock');
  var replay = document.getElementById('termReplay');
  if (!term || !log) return;

  // waveform bars
  for (var i = 0; i < 34; i++){
    var b = document.createElement('i');
    b.style.setProperty('--h', (2.4 + Math.abs(Math.sin(i * 1.7)) * 7.5).toFixed(2));
    b.style.animationDelay = (i * 42 % 700) + 'ms';
    wave.appendChild(b);
  }

  var SCRIPT = [
    { t: 'status', v: 'Incoming', cls: 'ring', wait: 900 },
    { t: 'status', v: 'Answered · 0.4s', cls: 'live', wait: 480 },
    { t: 'say', who: 'caller', text: "Hi — I need to move my stress test. Something came up Thursday." },
    { t: 'rail', k: 'intent', v: 'Reschedule' },
    { t: 'rail', k: 'patient', v: 'Matched · record found' },
    { t: 'think', ms: 620 },
    { t: 'say', who: 'galen', text: "Of course. I have you down for Thursday the 12th at 9:00 with Dr. Cespedes. I can move you to Tuesday at 10:15, or Wednesday at 2:30 — which works better?" },
    { t: 'rail', k: 'procedure', v: 'Stress test' },
    { t: 'rail', k: 'provider', v: 'Dr. Cespedes' },
    { t: 'say', who: 'caller', text: "Tuesday works." },
    { t: 'think', ms: 500 },
    { t: 'say', who: 'galen', text: "Done. Tuesday the 17th at 10:15. I've texted your confirmation and the fasting instructions. Anything else I can take care of?" },
    { t: 'rail', k: 'slot', v: 'Tue 17th · 10:15 AM' },
    { t: 'commit' },
    { t: 'status', v: 'Call complete', cls: '', wait: 4200 }
  ];

  var run = 0, timer = null, clockTimer = null, elapsed = 0;

  function wait(ms, token){
    return new Promise(function(res){
      timer = setTimeout(function(){ if (token === run) res(); }, ms);
    });
  }

  function reset(){
    run++;
    clearTimeout(timer);
    clearInterval(clockTimer);
    log.innerHTML = '';
    term.classList.remove('live', 'ring', 'speaking', 'by-galen');
    commit.classList.remove('on');
    status.textContent = 'Standby';
    clock.textContent = '00:00';
    elapsed = 0;
    var items = rail.querySelectorAll('li');
    for (var i = 0; i < items.length; i++){
      items[i].classList.remove('set');
      items[i].querySelector('.rv').textContent = '';
    }
  }

  function startClock(){
    clearInterval(clockTimer);
    clockTimer = setInterval(function(){
      elapsed++;
      var mm = String(Math.floor(elapsed / 60)).padStart(2, '0');
      var ss = String(elapsed % 60).padStart(2, '0');
      clock.textContent = mm + ':' + ss;
    }, 1000);
  }

  async function type(node, text, token){
    var speed = 17;
    for (var i = 0; i < text.length; i++){
      if (token !== run) return;
      node.textContent = text.slice(0, i + 1);
      var ch = text[i];
      var pause = speed;
      if (ch === ' ') pause = speed * 0.5;
      if (ch === ',' || ch === '—') pause = speed * 7;
      if (ch === '.' || ch === '?') pause = speed * 11;
      await wait(pause, token);
    }
  }

  async function play(){
    var token = ++run;
    log.innerHTML = '';
    commit.classList.remove('on');
    var items = rail.querySelectorAll('li');
    for (var i = 0; i < items.length; i++){
      items[i].classList.remove('set');
      items[i].querySelector('.rv').textContent = '';
    }
    term.classList.remove('live', 'ring');
    elapsed = 0;
    clock.textContent = '00:00';

    for (var s = 0; s < SCRIPT.length; s++){
      if (token !== run) return;
      var step = SCRIPT[s];

      if (step.t === 'status'){
        status.textContent = step.v;
        term.classList.remove('ring', 'live');
        if (step.cls) term.classList.add(step.cls);
        if (step.cls === 'live') startClock();
        if (!step.cls) clearInterval(clockTimer);
        await wait(step.wait || 400, token);
        continue;
      }

      if (step.t === 'think'){
        var th = document.createElement('div');
        th.className = 'msg galen';
        th.innerHTML = '<span class="who">Galen</span><span class="bd"><span class="thinking"><i></i><i></i><i></i></span></span>';
        log.appendChild(th);
        await wait(step.ms, token);
        if (token !== run) return;
        th.remove();
        continue;
      }

      if (step.t === 'say'){
        var msg = document.createElement('div');
        msg.className = 'msg ' + step.who;
        var who = document.createElement('span');
        who.className = 'who';
        who.textContent = step.who === 'caller' ? 'Caller · +1 (305) •••• 4471' : 'Galen';
        var bd = document.createElement('span');
        bd.className = 'bd';
        var txt = document.createElement('span');
        var car = document.createElement('span');
        car.className = 'caret';
        bd.appendChild(txt); bd.appendChild(car);
        msg.appendChild(who); msg.appendChild(bd);
        log.appendChild(msg);

        term.classList.add('speaking');
        term.classList.toggle('by-galen', step.who === 'galen');
        await type(txt, step.text, token);
        if (token !== run) return;
        car.remove();
        term.classList.remove('speaking');
        await wait(430, token);
        continue;
      }

      if (step.t === 'rail'){
        var li = rail.querySelector('li[data-k="' + step.k + '"]');
        if (li){ li.querySelector('.rv').textContent = step.v; li.classList.add('set'); }
        await wait(240, token);
        continue;
      }

      if (step.t === 'commit'){
        commit.classList.add('on');
        await wait(900, token);
        continue;
      }
    }

    if (token !== run) return;
    clearInterval(clockTimer);
    await wait(2600, token);
    if (token === run) play();
  }

  if (replay){
    replay.addEventListener('click', function(){ reset(); play(); });
  }

  if (REDUCED){
    // Show the finished state; no typing, no loop.
    var items = rail.querySelectorAll('li');
    var vals = ['Reschedule', 'Matched · record found', 'Stress test', 'Dr. Cespedes', 'Tue 17th · 10:15 AM'];
    for (var q = 0; q < items.length; q++){ items[q].querySelector('.rv').textContent = vals[q]; items[q].classList.add('set'); }
    commit.classList.add('on');
    status.textContent = 'Call complete';
    clock.textContent = '00:41';
    for (var p = 0; p < SCRIPT.length; p++){
      var st = SCRIPT[p];
      if (st.t !== 'say') continue;
      var el = document.createElement('div');
      el.className = 'msg ' + st.who;
      el.style.animation = 'none';
      el.style.opacity = '1';
      el.style.transform = 'none';
      el.innerHTML = '<span class="who"></span><span class="bd"></span>';
      el.querySelector('.who').textContent = st.who === 'caller' ? 'Caller' : 'Galen';
      el.querySelector('.bd').textContent = st.text;
      log.appendChild(el);
    }
  } else if ('IntersectionObserver' in window){
    var started = false;
    // Read the LAST entry, not entries[0]: a single callback can carry several
    // threshold crossings, and acting on the stale one desyncs `started` so the
    // sequence never restarts.
    var tio = new IntersectionObserver(function(en){
      var last = en[en.length - 1];
      if (last.isIntersecting){
        if (!started){ started = true; play(); }
      } else if (started){
        reset();
        started = false;
      }
    }, { threshold: 0.22 });
    tio.observe(term);
  } else {
    play();
  }
})();

/* ═══════════════════════════════════════════════════════════════════════
   PRICING — structure / figures
   ═══════════════════════════════════════════════════════════════════════ */
(function(){
  var seg  = document.querySelector('.seg');
  var bS   = document.getElementById('segStructure');
  var bN   = document.getElementById('segNumbers');
  var pS   = document.getElementById('paneStructure');
  var pN   = document.getElementById('paneNumbers');
  if (!seg || !bS || !bN || !pS || !pN) return;

  function set(mode){
    var isNum = mode === 'numbers';
    seg.classList.toggle('b', isNum);
    bN.setAttribute('aria-selected', String(isNum));
    bS.setAttribute('aria-selected', String(!isNum));
    pN.hidden = !isNum;
    pS.hidden = isNum;
  }

  bS.addEventListener('click', function(){ set('structure'); });
  bN.addEventListener('click', function(){ set('numbers'); });
  seg.addEventListener('keydown', function(e){
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    e.preventDefault();
    var toNum = e.key === 'ArrowRight';
    set(toNum ? 'numbers' : 'structure');
    (toNum ? bN : bS).focus();
  });
})();

/* ═══════════════════════════════════════════════════════════════════════
   FAQ
   ═══════════════════════════════════════════════════════════════════════ */
(function(){
  var wrap = document.getElementById('faqWrap');
  if (!wrap) return;
  var rows = wrap.querySelectorAll('.qa');

  function shut(row){
    var ans = row.querySelector('.ans');
    ans.style.height = ans.scrollHeight + 'px';
    void ans.offsetHeight;
    ans.style.height = '0px';
    row.classList.remove('open');
    row.querySelector('button').setAttribute('aria-expanded', 'false');
  }

  for (var i = 0; i < rows.length; i++){
    (function(row){
      var btn = row.querySelector('button');
      var ans = row.querySelector('.ans');
      btn.addEventListener('click', function(){
        var isOpen = row.classList.contains('open');
        for (var j = 0; j < rows.length; j++){
          if (rows[j] !== row && rows[j].classList.contains('open')) shut(rows[j]);
        }
        if (isOpen){ shut(row); measure(); return; }
        row.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        ans.style.height = ans.scrollHeight + 'px';
        measure();   // document height changed — refresh scroll ceiling
      });
      ans.addEventListener('transitionend', function(e){
        if (e.propertyName === 'height' && row.classList.contains('open')) ans.style.height = 'auto';
      });
    })(rows[i]);
  }

  window.addEventListener('resize', function(){
    for (var k = 0; k < rows.length; k++){
      if (rows[k].classList.contains('open')) rows[k].querySelector('.ans').style.height = 'auto';
    }
  }, { passive: true });
})();

/* ═══════════════════════════════════════════════════════════════════════
   MOBILE DRAWER
   ═══════════════════════════════════════════════════════════════════════ */
var burger = document.getElementById('burger');
var drawer = document.getElementById('drawer');

function closeMenu(){
  if (!document.body.classList.contains('menu-open')) return;
  document.body.classList.remove('menu-open');
  if (burger){ burger.setAttribute('aria-expanded', 'false'); burger.setAttribute('aria-label', 'Open menu'); }
  if (drawer) drawer.setAttribute('aria-hidden', 'true');
  syncNavSurface();
}

if (burger && drawer){
  var links = drawer.querySelectorAll('li a');
  for (var L = 0; L < links.length; L++){
    links[L].style.transitionDelay = (120 + L * 62) + 'ms';
  }
  burger.addEventListener('click', function(){
    var open = document.body.classList.toggle('menu-open');
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    drawer.setAttribute('aria-hidden', String(!open));
    syncNavSurface();   // drawer is obsidian — the bar must not stay inverted
  });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeMenu(); });
}

/* ═══════════════════════════════════════════════════════════════════════
   NAV SURFACE DETECTION — invert the bar over light sections
   ═══════════════════════════════════════════════════════════════════════ */
var lightUnderNav = new Set();

function syncNavSurface(){
  if (!navEl) return;
  navEl.classList.toggle('on-light', lightUnderNav.size > 0 && !document.body.classList.contains('menu-open'));
}

(function(){
  var lights = document.querySelectorAll('.on-bone');
  if (!lights.length || !('IntersectionObserver' in window)) return;
  var surfaceIO = null;

  // A 1px detection band across the nav's own midline: a section counts as
  // "under the nav" the moment its edge crosses that line, so the inversion
  // flips at the visual midpoint of the bar rather than at its top or bottom.
  function build(){
    if (surfaceIO) surfaceIO.disconnect();
    var line = 33;
    var bottom = Math.max(0, window.innerHeight - line - 1);
    surfaceIO = new IntersectionObserver(function(entries){
      for (var i = 0; i < entries.length; i++){
        if (entries[i].isIntersecting) lightUnderNav.add(entries[i].target);
        else lightUnderNav.delete(entries[i].target);
      }
      syncNavSurface();
    }, { rootMargin: '-' + line + 'px 0px -' + bottom + 'px 0px', threshold: 0 });
    for (var i = 0; i < lights.length; i++) surfaceIO.observe(lights[i]);
  }

  build();
  var t = null;
  window.addEventListener('resize', function(){
    clearTimeout(t);
    t = setTimeout(function(){ lightUnderNav.clear(); build(); }, 160);
  }, { passive: true });
})();

/* ═══════════════════════════════════════════════════════════════════════
   NAV SCROLL-SPY
   ═══════════════════════════════════════════════════════════════════════ */
(function(){
  var spied = document.querySelectorAll('.nav-links a.nl');
  if (!spied.length || !('IntersectionObserver' in window)) return;
  var map = {};
  var watch = [];
  for (var i = 0; i < spied.length; i++){
    var id = spied[i].getAttribute('href');
    var sec = document.querySelector(id);
    if (!sec) continue;
    map[id] = spied[i];
    watch.push(sec);
  }
  var spy = new IntersectionObserver(function(entries){
    for (var i = 0; i < entries.length; i++){
      var link = map['#' + entries[i].target.id];
      if (link) link.classList.toggle('active', entries[i].isIntersecting);
    }
  }, { rootMargin: '-45% 0px -50% 0px' });
  for (var w = 0; w < watch.length; w++) spy.observe(watch[w]);
})();

/* ═══════════════════════════════════════════════════════════════════════
   INTAKE FORM → POST /api/contact  (type:'galen' — contract unchanged)
   ═══════════════════════════════════════════════════════════════════════ */
(function(){
  var form = document.getElementById('intakeForm');
  if (!form) return;
  var EMAIL = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
  var LABEL = 'Book an intake call';
  var FIELDS = ['practice', 'name', 'email', 'phone', 'specialty', 'volume'];

  form.addEventListener('submit', async function(e){
    e.preventDefault();

    var valid = true;
    var stale = form.querySelectorAll('.f.err');
    for (var i = 0; i < stale.length; i++) stale[i].classList.remove('err');
    var msgs = form.querySelectorAll('.em');
    for (var j = 0; j < msgs.length; j++) msgs[j].remove();

    var first = null;
    for (var k = 0; k < FIELDS.length; k++){
      var id = FIELDS[k];
      var el = document.getElementById(id);
      var val = (el.value || '').trim();
      var err = '';
      if (!val) err = 'Required';
      else if (id === 'email' && !EMAIL.test(val)) err = 'Enter a valid email';
      else if (id === 'phone' && val.replace(/\D/g, '').length < 7) err = 'Enter a valid phone';
      if (!err) continue;
      valid = false;
      var field = el.closest('.f');
      field.classList.add('err');
      var n = document.createElement('div');
      n.className = 'em';
      n.textContent = err;
      field.appendChild(n);
      if (!first) first = el;
    }
    if (!valid){ if (first) first.focus(); return; }

    var btn = document.getElementById('intakeBtn');
    var note = document.getElementById('intakeNote');
    var lbl = btn.querySelector('.l');
    btn.disabled = true;
    if (lbl) lbl.textContent = 'Sending…';

    try {
      var resp = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          type: 'galen',
          practice:  document.getElementById('practice').value.trim(),
          name:      document.getElementById('name').value.trim(),
          email:     document.getElementById('email').value.trim(),
          phone:     document.getElementById('phone').value.trim(),
          specialty: document.getElementById('specialty').value.trim(),
          volume:    document.getElementById('volume').value.trim(),
          message:   (document.getElementById('message').value || '').trim()
        })
      });

      if (resp.ok){
        document.getElementById('intakeContent').innerHTML =
          '<div class="done">' +
          '<div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5FBF9B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></div>' +
          '<h3>Request received.</h3>' +
          '<p>You&rsquo;ll hear from ARX within 24 hours &mdash; usually much sooner.</p>' +
          '</div>';
        measure();
      } else {
        btn.disabled = false;
        if (lbl) lbl.textContent = LABEL;
        if (note){ note.classList.add('bad'); note.textContent = 'Something went wrong. Please try again in a moment.'; }
      }
    } catch (err){
      btn.disabled = false;
      if (lbl) lbl.textContent = LABEL;
      if (note){ note.classList.add('bad'); note.textContent = 'Network error. Please try again in a moment.'; }
    }
  });
})();

/* ═══════════════════════════════════════════════════════════════════════
   BOOT
   ═══════════════════════════════════════════════════════════════════════ */
measure();
window.addEventListener('load', measure);
if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);

})();
</script>
</body>
</html>
