<script is:inline>
// ECG waveform generator — cardiology signature
(function(){
  const path=document.getElementById('ecgPath');
  if(!path) return;
  const W=880, mid=52;
  let d=`M0 ${mid}`;
  function beat(cx){
    return ` L${cx-30} ${mid} L${cx-20} ${mid-4} L${cx-12} ${mid+6} `+
           `L${cx-6} ${mid} L${cx} ${mid-38} L${cx+6} ${mid+20} `+
           `L${cx+12} ${mid} L${cx+22} ${mid-8} L${cx+38} ${mid}`;
  }
  for(let cx=110; cx<W; cx+=190){ d+=beat(cx); }
  d+=` L${W} ${mid}`;
  path.setAttribute('d', d);
})();

// Pricing toggle
function setPrice(mode){
  var s=document.getElementById('cardStructure'), n=document.getElementById('cardNumbers');
  var ts=document.getElementById('tgStructure'), tn=document.getElementById('tgNumbers');
  var note=document.getElementById('toggleNote');
  if(mode==='numbers'){
    s.style.display='none'; n.style.display='block';
    tn.classList.add('active'); ts.classList.remove('active');
    note.textContent='Literal figures — anchors every prospect and competitor to these numbers.';
  } else {
    s.style.display='block'; n.style.display='none';
    ts.classList.add('active'); tn.classList.remove('active');
    note.textContent='Recommended for a warm-intro sale — frames the model, quotes the number in the room.';
  }
}

// FAQ accordion
document.querySelectorAll('.qa button').forEach(function(b){
  b.addEventListener('click', function(){
    const qa=b.parentElement;
    const ans=qa.querySelector('.ans');
    const open=qa.classList.contains('open');
    document.querySelectorAll('.qa').forEach(function(x){
      x.classList.remove('open');
      x.querySelector('.ans').style.maxHeight=null;
      x.querySelector('.ai').textContent='+';
    });
    if(!open){
      qa.classList.add('open');
      ans.style.maxHeight=ans.scrollHeight+'px';
      qa.querySelector('.ai').textContent='+';
    }
  });
});

// Intake form → POST /api/contact (Resend-backed endpoint, Galen contract)
(function(){
  var form=document.getElementById('intakeForm');
  if(!form) return;
  var EMAIL=/^[^@\s]+@[^@\s]+\.[^@\s]+$/;
  var LABEL='Book an intake call';
  form.addEventListener('submit', async function(e){
    e.preventDefault();
    var valid=true;
    form.querySelectorAll('.if-field').forEach(function(f){ f.classList.remove('error'); });
    form.querySelectorAll('.err').forEach(function(n){ n.remove(); });
    ['practice','name','email','phone','specialty','volume'].forEach(function(id){
      var el=document.getElementById(id);
      var val=(el.value||'').trim();
      var err='';
      if(!val) err='Required';
      else if(id==='email' && !EMAIL.test(val)) err='Enter a valid email';
      else if(id==='phone' && val.replace(/\D/g,'').length<7) err='Enter a valid phone';
      if(err){
        valid=false;
        var field=el.closest('.if-field');
        field.classList.add('error');
        var n=document.createElement('div');
        n.className='err'; n.textContent=err;
        field.appendChild(n);
      }
    });
    if(!valid) return;

    var btn=document.getElementById('intakeBtn');
    var note=document.getElementById('intakeNote');
    btn.disabled=true; btn.textContent='Sending…';

    try{
      var resp=await fetch('/api/contact', {
        method:'POST',
        headers:{ 'Content-Type':'application/json' },
        body:JSON.stringify({
          type:'galen',
          practice:document.getElementById('practice').value.trim(),
          name:document.getElementById('name').value.trim(),
          email:document.getElementById('email').value.trim(),
          phone:document.getElementById('phone').value.trim(),
          specialty:document.getElementById('specialty').value.trim(),
          volume:document.getElementById('volume').value.trim(),
          message:(document.getElementById('message').value||'').trim(),
        }),
      });
      if(resp.ok){
        document.getElementById('intakeContent').innerHTML=
          '<div class="if-success">'+
          '<div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#43D6A0" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></div>'+
          '<h3>Request received.</h3>'+
          '<p>You’ll hear from ARX within 24 hours — usually much sooner.</p>'+
          '</div>';
      } else {
        btn.disabled=false; btn.textContent=LABEL;
        if(note){ note.style.color='var(--clay-soft)'; note.textContent='Something went wrong. Please email gabrielcespedes777@gmail.com directly.'; }
      }
    } catch(err){
      btn.disabled=false; btn.textContent=LABEL;
      if(note){ note.style.color='var(--clay-soft)'; note.textContent='Network error. Please try again, or email gabrielcespedes777@gmail.com directly.'; }
    }
  });
})();
</script>
