---
// Holding page. Replaces the Galen-era site at arxsystems.org while the
// editorial rebuild waits for sign-off. Renders one line of copy, one mailto.
// No nav, no footer, no JS, no view-transitions. Editorial register kept
// (Fraunces / Inter / paper / forest accent) so the site does not read as broken.
//
// When the homepage port is approved, this file is replaced by the editorial
// home. The full editorial draft is parked at src/pages/_editorial-home.astro
// (the `_` prefix tells Astro to skip routing).

const description = 'ARX Systems — site under refresh.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ARX Systems</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="ARX Systems" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#1d3a2c" />
    <link rel="icon" href="/arx-mark.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preload" href="/fonts/body/Inter-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <style>
      @font-face {
        font-family: 'Fraunces';
        src: url('/fonts/display/Fraunces-Variable.woff2') format('woff2-variations'),
             url('/fonts/display/Fraunces-Variable.woff2') format('woff2');
        font-weight: 300 900; font-style: normal; font-display: swap;
      }
      @font-face {
        font-family: 'Inter';
        src: url('/fonts/body/Inter-Variable.woff2') format('woff2-variations'),
             url('/fonts/body/Inter-Variable.woff2') format('woff2');
        font-weight: 100 900; font-style: normal; font-display: swap;
      }
      @font-face {
        font-family: 'JetBrains Mono';
        src: url('/fonts/mono/JetBrainsMono-Variable.woff2') format('woff2-variations'),
             url('/fonts/mono/JetBrainsMono-Variable.woff2') format('woff2');
        font-weight: 100 800; font-style: normal; font-display: swap;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        min-height: 100vh;
        background: #f4efe6;
        color: #14110d;
        font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        display: grid;
        grid-template-rows: auto 1fr auto;
      }
      ::selection { background: #1d3a2c; color: #f4efe6; }
      a { color: inherit; }
      a:focus-visible { outline: 2px solid #1d3a2c; outline-offset: 3px; border-radius: 2px; }

      header.top, footer.bottom {
        padding: 28px clamp(20px, 4vw, 40px);
        display: flex; align-items: center; justify-content: space-between;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 11px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #6e6557;
      }
      header.top .brand {
        font-family: 'Fraunces', Georgia, serif;
        font-size: 20px;
        font-weight: 400;
        letter-spacing: -0.02em;
        text-transform: none;
        color: #14110d;
      }
      main {
        display: grid; place-items: center;
        padding: clamp(48px, 10vw, 96px) clamp(20px, 4vw, 40px);
      }
      .card { max-width: 640px; text-align: left; }
      .marker {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 11px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #1d3a2c;
        margin: 0 0 24px;
      }
      h1 {
        font-family: 'Fraunces', Georgia, serif;
        font-weight: 400;
        font-size: clamp(32px, 5.5vw, 56px);
        line-height: 1.08;
        letter-spacing: -0.02em;
        margin: 0 0 28px;
        text-wrap: balance;
      }
      h1 em { color: #1d3a2c; font-style: italic; }
      p.lede {
        font-size: clamp(17px, 2vw, 19px);
        line-height: 1.7;
        color: #3a342c;
        margin: 0 0 32px;
        max-width: 52ch;
        text-wrap: pretty;
      }
      a.mail {
        display: inline-flex; align-items: center; gap: 8px;
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 15px;
        color: #14110d;
        text-decoration: underline;
        text-decoration-color: #1d3a2c;
        text-decoration-thickness: 1px;
        text-underline-offset: 5px;
      }
      a.mail:hover { text-decoration-color: #14110d; }

      footer.bottom { border-top: 1px solid #d9d1bf; }
      footer.bottom .right { text-align: right; }
      @media (max-width: 520px) {
        header.top, footer.bottom { flex-direction: column; gap: 6px; align-items: flex-start; }
        footer.bottom .right { text-align: left; }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition: none !important; }
      }
    </style>
  </head>
  <body>
    <header class="top">
      <span class="brand">ARX Systems</span>
      <span>Miami · By application</span>
    </header>
    <main>
      <article class="card">
        <p class="marker">— Notice</p>
        <h1>Site <em>under refresh.</em></h1>
        <p class="lede">
          ARX Systems is rebuilding its public site. The firm continues to take on a small number of
          specialty physician practices each quarter, by application only.
        </p>
        <p class="lede" style="margin-bottom: 12px;">
          For inquiries:
        </p>
        <a class="mail" href="mailto:gabriel@arxsystems.co">gabriel@arxsystems.co →</a>
      </article>
    </main>
    <footer class="bottom">
      <span>&copy; ARX Systems</span>
      <span class="right">The Cespedes Method · Co-developed with Edgardo M. Cespedes, MD</span>
    </footer>
  </body>
</html>
