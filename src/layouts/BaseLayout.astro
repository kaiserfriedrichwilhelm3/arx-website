---
/*
 * BaseLayout.astro — sitewide page shell.
 *
 * Mounts: <html><head><body> + global.css + Nav + <slot> for page
 * content. Footer is added in commit (f). Font preload links land
 * in Pass 1 when fonts.css and self-hosted .woff2 files arrive.
 *
 * Every page in src/pages/*.astro should wrap its content in this
 * layout. Pages pass title (required), description (optional),
 * ogImage (optional) as props for the <head>.
 */
import "../styles/global.css";
import Nav from "../components/Nav.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const {
  title,
  description = "Medical-grade AI receptionists for private practices.",
  ogImage = "/og-image.png",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/arx-mark.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title}</title>
  </head>
  <body>
    <Nav currentPath={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
