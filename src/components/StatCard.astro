---
/*
 * StatCard.astro — number + label.
 *
 * Composes horizontally in trios on pages (e.g., "24/7 · 35+ languages
 * · 0 retention"). Borderless; visual rhythm comes from a hairline
 * above the value. tabular-nums + lining-nums on the value so numbers
 * align visually when stacked in a row.
 */
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---
<div class="stat">
  <div class="stat-value">{value}</div>
  <div class="stat-label">{label}</div>
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block-start: var(--space-3);
    border-top: var(--border-hairline);
  }
  .stat-value {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    line-height: var(--leading-snug);
    color: var(--ink);
    font-weight: 400;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    line-height: var(--leading-mono);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--muted);
  }
</style>
