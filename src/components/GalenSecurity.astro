---
/*
 * GalenSecurity.astro — single bordered panel linking to the
 * eventual Pass 4 /security page.
 *
 * Intentionally NOT an inline security list. The page exists to
 * say "we have an architecture for this; here's where to read it."
 * Detail belongs on /security itself.
 *
 * /security renders 404 until Pass 4 ships — that's acceptable per
 * the Pass 2 brief.
 */
import Kicker from "./Kicker.astro";
import Button from "./Button.astro";
---
<section class="gsec" aria-labelledby="gsec-heading">
  <div class="gsec-inner">
    <div class="gsec-panel">
      <Kicker>03 · Security</Kicker>
      <h3 id="gsec-heading" class="gsec-heading">
        PHI handled with zero retention by default.
      </h3>
      <p class="gsec-body">
        Galen is built for HIPAA-aligned medical workflows. Patient
        information is processed and discarded — we retain no PHI,
        and your data never trains a model.
      </p>
      <div class="gsec-cta">
        <Button variant="secondary" href="/security">
          Read the security architecture →
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .gsec {
    padding-block: var(--space-7) 0;
  }
  .gsec-inner {
    max-width: var(--container-prose);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
  .gsec-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    background: var(--bg);
  }
  .gsec-heading {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--leading-snug);
    color: var(--ink);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .gsec-body {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--leading-base);
    color: var(--muted);
    margin: 0;
    max-width: 480px;
  }
  .gsec-cta {
    margin-top: var(--space-2);
  }
</style>
